# Скрипт для разработки под NixOS.
if has nix-shell; then
  use nix
fi

# Project secrets / local overrides (file is gitignored)
if [ -f .env ]; then
  dotenv .env
fi

if has poetry && [ -f pyproject.toml ]; then
  watch_file pyproject.toml poetry.lock
  ENV_PATH="$(poetry env info -p 2>/dev/null || true)"
  if [ -n "$ENV_PATH" ]; then
    export VIRTUAL_ENV="$ENV_PATH"
    PATH_add "$VIRTUAL_ENV/bin"
  fi
fi
